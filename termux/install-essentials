#!/usr/bin/env bash
#
# install-essentials — install essential packages for the Termux environment.
#
# Usage:
#   ./install-essentials
#   FORCE=1 ./install-essentials   # bypass Termux environment check
#

set -euo pipefail

have() { command -v "$1" >/dev/null 2>&1; }

is_termux() {
  [[ -n "${TERMUX_VERSION:-}" || "${PREFIX:-}" == *"/com.termux/"* || -d "/data/data/com.termux" ]] || [[ "$(uname -o 2>/dev/null)" == "Android" ]]
}

FORCE_FLAG="${FORCE:-0}"
for arg in "$@"; do
  case "$arg" in
    -f|--force) FORCE_FLAG=1 ;;
    -h|--help)  awk 'NR<3 {next} /^#/ {sub(/^# ?/,""); print; next} {exit}' "${BASH_SOURCE[0]}"; exit 0 ;;
  esac
done

export PATH="${CARGO_HOME:-$HOME/.cargo}/bin:$HOME/.local/bin:${PREFIX:-/data/data/com.termux/files/usr}/bin:$PATH"

if ! is_termux && [[ "$FORCE_FLAG" -ne 1 ]]; then
  echo "WARNING: Not running in a Termux environment." >&2
  echo "This script is intended for Termux on Android." >&2
  echo "Set FORCE=1 or pass --force to run anyway." >&2
  exit 1
fi

if ! have pkg; then
  echo "ERROR: 'pkg' command not found. Please run within Termux or install Termux packages." >&2
  exit 1
fi

echo "==> Updating Termux package lists..."
pkg update -y || echo "  WARNING: pkg update had errors; continuing with existing package lists..." >&2

PACKAGES=(
  git
  python
  mosh
  tmux
  zsh
  vim
  termux-api
  nodejs
  wget
  curl
  openssh
  gh
  fzf
)

echo "==> Installing essential Termux packages..."
echo "    ${PACKAGES[*]}"
pkg install -y "${PACKAGES[@]}"

echo "==> Setting up uv (Python package manager)..."
PREFIX_BIN="${PREFIX:-/data/data/com.termux/files/usr}/bin"

if have uv; then
  echo "  ok      uv (found $(command -v uv))"
else
  # 1. Try native Termux package via pkg
  echo "  --> Trying Termux package repository (pkg install uv)..."
  if pkg install -y uv 2>/dev/null && have uv; then
    echo "  ok      uv installed via Termux package repository"
  # 2. Try compiling on-device with cargo/rust
  else
    echo "  --> Native package unavailable. Attempting on-device compilation with rust/cargo..."
    if pkg install -y rust binutils clang make cmake 2>/dev/null; then
      if cargo install --locked uv; then
        CARGO_UV="${CARGO_HOME:-$HOME/.cargo}/bin/uv"
        if [[ -f "$CARGO_UV" ]]; then
          ln -sf "$CARGO_UV" "$PREFIX_BIN/uv" 2>/dev/null || true
        fi
        if have uv; then
          echo "  ok      uv compiled and installed via cargo"
        fi
      fi
    fi
  fi

  # 3. Fallbacks: pip or astral install script
  if ! have uv; then
    echo "  --> Trying pip / astral installer fallback..."
    if python3 -m pip install uv --break-system-packages 2>/dev/null; then
      if [[ -f "$HOME/.local/bin/uv" ]]; then
        ln -sf "$HOME/.local/bin/uv" "$PREFIX_BIN/uv" 2>/dev/null || true
      fi
      if have uv; then
        echo "  ok      uv installed via pip"
      fi
    elif curl -LsSf https://astral.sh/uv/install.sh | sh 2>/dev/null; then
      if [[ -f "$HOME/.local/bin/uv" ]]; then
        ln -sf "$HOME/.local/bin/uv" "$PREFIX_BIN/uv" 2>/dev/null || true
      fi
      if have uv; then
        echo "  ok      uv installed via astral install script"
      fi
    fi
  fi

  # Final verification / troubleshooting guidance
  if have uv; then
    echo "  ok      uv is ready at $(command -v uv)"
  else
    echo "  note    uv could not be installed directly in Termux."
    echo "          Options:"
    echo "          1. Run 'pkg install uv' (ensure repositories are updated via 'pkg update')"
    echo "          2. Compile on-device: 'pkg install rust clang binutils make cmake && cargo install --locked uv'"
    echo "          3. Use a glibc proot environment: 'pkg install proot-distro && proot-distro install debian'"
  fi
fi

echo "==> Verifying Termux font & Nerd Font icons..."
TERMUX_FONT="$HOME/.termux/font.ttf"
if [[ -f "$TERMUX_FONT" ]]; then
  echo "  ok      terminal font found at $TERMUX_FONT"
else
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  if [[ -f "$SCRIPT_DIR/font.ttf" ]]; then
    mkdir -p "$HOME/.termux"
    cp "$SCRIPT_DIR/font.ttf" "$TERMUX_FONT" 2>/dev/null || ln -sf "$SCRIPT_DIR/font.ttf" "$TERMUX_FONT"
    echo "  ok      installed bundled Iosevka Term Nerd Font to $TERMUX_FONT"
    if have termux-reload-settings; then
      termux-reload-settings || true
    fi
  else
    echo "  --> Downloading Iosevka Term Nerd Font..."
    mkdir -p "$HOME/.termux"
    local_archive="/tmp/IosevkaTerm.tar.xz"
    if curl -sL "https://github.com/ryanoasis/nerd-fonts/releases/download/v3.3.0/IosevkaTerm.tar.xz" -o "$local_archive" 2>/dev/null && tar -xf "$local_archive" -C "$HOME/.termux" IosevkaTermNerdFont-Regular.ttf 2>/dev/null; then
      mv -f "$HOME/.termux/IosevkaTermNerdFont-Regular.ttf" "$TERMUX_FONT"
      rm -f "$local_archive"
      echo "  ok      downloaded and installed Iosevka Term Nerd Font to $TERMUX_FONT"
      if have termux-reload-settings; then
        termux-reload-settings || true
      fi
    else
      rm -f "$local_archive"
      echo "  note    Nerd Font could not be installed directly. Terminal will fallback to representative characters."
    fi
  fi
fi

echo
echo "==> Termux essentials installed successfully."
