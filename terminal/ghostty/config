# Window style
window-step-resize = true
window-height = 100
window-width = 100

# Misc.
copy-on-select = false
macos-option-as-alt = true
macos-titlebar-style = hidden

# Keybindings
# Clear default Ghostty keybindings so macOS menu accelerators (like super+d split,
# super+n window, super+c copy, super+a select all) do not intercept Caps Lock (Command)
# before key-remap can convert it to Control.
keybind = clear

# Remap super <-> ctrl so macOS Caps Lock (mapped to Command) sends terminal Ctrl
# while physical Control triggers Ghostty super shortcuts.
key-remap = super=ctrl
key-remap = ctrl=super

keybind = global:ctrl+escape=toggle_quick_terminal
keybind = super+shift+,=reload_config
keybind = super+==increase_font_size:1
keybind = super++=increase_font_size:1
keybind = super+-=decrease_font_size:1
keybind = super+0=reset_font_size

# Copy and paste.  `keybind = clear' took Ghostty's own super+c and super+v out
# along with the menu accelerators, and nothing put them back -- with
# copy-on-select false as well, there was no route to the clipboard from the
# keyboard at all.
#
# `super' here means the *physical Control* key, because key-remap above is
# applied before keybind matching ("This affects both keybind matching and
# terminal input encoding", ghostty +show-config --docs).  So copy is physical
# Ctrl+C, and Caps Lock (Command) + C still remaps to ctrl+c and reaches the
# shell as SIGINT, which is the whole point of the remap.
#
# `performable:' is what makes these safe to have back rather than a return of
# the bug `clear' was added for.  Ghostty's docs say a menu binding "will
# trigger before any remapping is done", so a plain `super+c' would be
# registered as the Edit > Copy accelerator and macOS would swallow Caps Lock + C
# before key-remap ever saw it -- SIGINT gone again.  A performable keybind
# "will not appear as menu shortcuts in the application menu", so it is bound
# without ever becoming an accelerator.  The same reasoning covers paste: as a
# menu shortcut it would eat Caps Lock + V, and `C-v' is scroll-down in Emacs.
#
# The cost of `performable:' is that copy only consumes the key when there is a
# selection to copy.  With nothing selected, physical Ctrl+C does nothing, which
# is the right outcome here -- SIGINT is Caps Lock + C by design.
keybind = performable:super+c=copy_to_clipboard:mixed
keybind = performable:super+v=paste_from_clipboard
keybind = performable:super+shift+v=paste_from_selection

# The dedicated clipboard keys some keyboards carry.  No modifier, so no menu
# accelerator to worry about; these are simply part of the default set that
# `clear' removed.
keybind = copy=copy_to_clipboard:mixed
keybind = paste=paste_from_clipboard

background-opacity = 0.83

cursor-style = block
mouse-hide-while-typing = true
background-blur-radius = 20
quick-terminal-position = bottom
quick-terminal-size = 45%

font-family = "Iosevka Term"
font-size = 16

theme = Horizon

# Terminal identity over ssh and sudo.
#
# Ghostty reports TERM=xterm-ghostty and points TERMINFO at its own bundle. That
# entry is richer than xterm-256color (truecolor via Tc/setrgbf, full key
# reporting), so nothing should be overriding it locally -- but a remote host
# will not have the entry, which used to be worked around by exporting
# TERM=xterm-256color from ~/.zshrc. That fixed ssh by lying to every other
# program, tmux and Emacs included.
#
# Fixed at the source instead:
#   ssh-terminfo  installs the xterm-ghostty entry on the remote host with
#                 infocmp + tic (cached per host, see `ghostty +ssh-cache`), and
#                 falls back to xterm-256color for that session alone when the
#                 remote has no tic.
#   ssh-env       forwards COLORTERM/TERM_PROGRAM so the remote knows it has
#                 truecolor.
#   sudo          keeps TERMINFO across sudo, which otherwise drops it and
#                 leaves `sudo emacs -nw` without a terminfo entry.
#
# The defaults being kept (cursor, title, path) are listed explicitly so this
# does not depend on whether an explicit list replaces the defaults or adds to
# them.
shell-integration-features = cursor,sudo,title,path,ssh-env,ssh-terminfo
