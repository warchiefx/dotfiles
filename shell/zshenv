# ~/.zshenv — read by EVERY zsh, interactive or not.
#
# Its one job is PATH, and specifically the part that *non-interactive* shells
# need. `ssh host <command>` runs a non-interactive, non-login shell, and zsh
# reads only this file for one -- not .zprofile, where the interactive setup
# (brew shellenv, pyenv, cargo) lives.
#
# That is why `mosh host` failed with "mosh-server not found" on a machine where
# mosh was installed: the client starts the server with roughly
# `ssh host mosh-server new`, and the PATH such a shell gets on macOS is
# /bin:/usr/bin:/usr/ucb:/usr/local/bin -- which does not include Homebrew's
# /opt/homebrew/bin on Apple Silicon. Same reason a remote `qs` or `claude`
# invocation cannot be found.
#
# Keep this file cheap. It runs for every shell script too, so no subprocesses
# (an `eval "$(brew shellenv)"` here costs a fork per shell), nothing that
# prints, and nothing interactive.

# -U keeps the array deduplicated, so .zprofile prepending the same directories
# later is a no-op rather than a growing PATH.
typeset -gU path PATH

# Homebrew, whichever prefix this machine uses: /opt/homebrew on Apple Silicon,
# /usr/local on Intel. Neither exists on Linux, where these tools are already in
# /usr/bin, so the loop simply adds nothing there.
# Iterated least-preferred first, because each match *prepends*: on a machine
# carrying both (an Intel brew left over under Rosetta beside a native one),
# /opt/homebrew must end up ahead of /usr/local, not behind it.
for _brew in /usr/local /opt/homebrew; do
  [[ -x $_brew/bin/brew ]] && path=($_brew/bin $_brew/sbin $path)
done
unset _brew

# Tools installed per-user rather than by a package manager. cargo's bin is
# where `qs` lands, which is the other thing a remote command could not find.
[[ -n "${PREFIX-}" && -d "$PREFIX/bin" ]] && path=($PREFIX/bin $PREFIX/bin/applets $path)
[[ -d $HOME/.cargo/bin ]] && path=($HOME/.cargo/bin $path)
[[ -d $HOME/.local/bin ]] && path=($HOME/.local/bin $path)

# On systems where hostname defaults to generic localhost (such as Android/Termux),
# resolve from ~/.hostname or Android device model properties.
if [[ "${HOST:-localhost}" == "localhost" || -z "${HOST:-}" ]]; then
  if [[ -r "$HOME/.hostname" ]]; then
    export HOST="$(<"$HOME/.hostname")"
  elif (( $+commands[getprop] )); then
    _dev="$(getprop ro.product.model 2>/dev/null || getprop ro.product.device 2>/dev/null)"
    [[ -n "$_dev" ]] && export HOST="${${(L)_dev// /-}//[^a-z0-9-_]/}"
    unset _dev
  fi
fi

# On Termux / Android, point SSH_AUTH_SOCK to the shared agent socket so all
# subshells, scripts, and Emacs child processes share the same agent.
if [[ -z "${SSH_AUTH_SOCK-}" && ( -n "${TERMUX_VERSION-}" || "$OSTYPE" == linux-android* || -d "/data/data/com.termux" ) ]]; then
  export SSH_AUTH_SOCK="$HOME/.ssh/ssh-agent.sock"
fi
