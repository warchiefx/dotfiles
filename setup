#!/usr/bin/env bash
#
# setup — install this shell environment on a machine.
#
# Owns everything needed to make these dotfiles work, which is more than the
# files themselves: zshrc sources prezto and is inert without it, tmux.conf
# expects tpm, and mosh needs a PATH that non-interactive ssh shells can see.
#
# The files are grouped by feature, one directory each, and every group carries a
# `manifest' saying where its files belong and which platforms want them. Nothing
# is linked unless a manifest declares it, so adding a file to this repository
# does not silently put something in $HOME.
#
# Deliberately self-contained. It resolves its own directory rather than a path
# relative to any other checkout, so it runs on a machine that has these
# dotfiles and nothing else.
#
# Usage:
#   ./setup                      # everything below
#   ./setup --list               # report what would change, do nothing
#   ./setup --only shell --only tmux   # just these features
#   ./setup --skip js            # everything but these
#   ./setup --link-only          # symlinks, no prezto/tpm/mosh/packages
#   ./setup --no-packages        # skip installing Termux packages
#   ./setup --no-mosh            # skip installing mosh
#   ./setup --no-chsh            # leave the login shell alone
#   ./setup --hostname <name>    # set machine name for prompt (~/.hostname)

set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PREZTO_REPO="${PREZTO_REPO:-https://github.com/sorin-ionescu/prezto.git}"
ZPREZTO_DIR="${ZDOTDIR:-$HOME}/.zprezto"
TPM_REPO="${TPM_REPO:-https://github.com/tmux-plugins/tpm.git}"
TPM_DIR="${TPM_DIR:-$HOME/.tmux/plugins/tpm}"
XDG_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}"

DO_LIST=0 DO_LINK_ONLY=0 DO_MOSH=1 DO_CHSH=1 DO_PACKAGES=1
CUSTOM_HOSTNAME=""
ONLY=() SKIP=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --list)        DO_LIST=1 ;;
    --link-only)   DO_LINK_ONLY=1 ;;
    --no-packages) DO_PACKAGES=0 ;;
    --no-mosh)     DO_MOSH=0 ;;
    --no-chsh)     DO_CHSH=0 ;;
    --hostname|-H) shift; [[ $# -gt 0 ]] || { echo "--hostname needs a name" >&2; exit 2; }; CUSTOM_HOSTNAME="$1" ;;
    --only)        shift; [[ $# -gt 0 ]] || { echo "--only needs a feature name" >&2; exit 2; }; ONLY+=("$1") ;;
    --skip)        shift; [[ $# -gt 0 ]] || { echo "--skip needs a feature name" >&2; exit 2; }; SKIP+=("$1") ;;
    -h|--help)     awk 'NR<3 {next} /^#/ {sub(/^# ?/,""); print; next} {exit}' "${BASH_SOURCE[0]}"; exit 0 ;;
    *) echo "unknown option: $1 (try --help)" >&2; exit 2 ;;
  esac
  shift
done

installed=() skipped=() failed=()

have() { command -v "$1" >/dev/null 2>&1; }

# ---------------------------------------------------------------------------
# Features and their manifests
#
# A feature is any directory here holding a `manifest'. That is the whole
# registry: no list to keep in step with the filesystem, and the transitional
# symlinks left at the old flat paths are ignored for free, since a symlink at
# the top level is not a directory with a manifest in it.
# ---------------------------------------------------------------------------

this_platform() {
  if [[ -n "${TERMUX_VERSION:-}" || "${PREFIX:-}" == *"/com.termux/"* || -d "/data/data/com.termux" ]] || [[ "$(uname -o 2>/dev/null)" == "Android" ]]; then
    echo termux
  else
    case "$(uname -s)" in
      Darwin) echo macos ;;
      Linux)  echo linux ;;
      *)      echo other ;;
    esac
  fi
}
PLATFORM="$(this_platform)"

feature_list() {
  local path
  for path in "$DOTFILES_DIR"/*/manifest; do
    [[ -f "$path" ]] || continue
    basename "$(dirname "$path")"
  done | sort
}

feature_exists() {
  local candidate="$1" name
  while read -r name; do
    [[ "$name" == "$candidate" ]] && return 0
  done < <(feature_list)
  return 1
}

in_list() {
  local needle="$1"; shift
  local item
  for item in "$@"; do
    [[ "$item" == "$needle" ]] && return 0
  done
  return 1
}

# Features to act on, after --only and --skip. --only wins where both name the
# same feature, on the grounds that the narrower flag is the more deliberate one.
selected_features() {
  local name
  while read -r name; do
    if [[ ${#ONLY[@]} -gt 0 ]]; then
      in_list "$name" "${ONLY[@]}" || continue
    elif [[ ${#SKIP[@]} -gt 0 ]] && in_list "$name" "${SKIP[@]}"; then
      continue
    fi
    printf '%s\n' "$name"
  done < <(feature_list)
}

# Emits "source<TAB>target<TAB>platform" for each declared entry, target already
# expanded. Comments and blank lines are dropped; a missing platform means both.
manifest_entries() {
  local feature="$1" src target platform
  while read -r src target platform; do
    [[ -n "$src" ]] || continue
    [[ "$src" == \#* ]] && continue
    target="${target/#\~/$HOME}"
    target="${target//\$XDG_CONFIG_HOME/$XDG_CONFIG_DIR}"
    # A target that did not expand to an absolute path is a manifest typo, and a
    # silently relative one is the worst outcome: `mkdir -p' would create the
    # literal directory next to wherever the script was invoked from. Refuse it.
    if [[ "$target" != /* ]]; then
      printf '%s\t%s\tBAD\n' "$src" "$target"
      continue
    fi
    printf '%s\t%s\t%s\n' "$src" "$target" "${platform:-any}"
  done < "$DOTFILES_DIR/$feature/manifest"
}

wanted_here() {
  local platform="$1"
  [[ "$platform" == "any" || "$platform" == "$PLATFORM" ]]
}

# ---------------------------------------------------------------------------
# Linking
# ---------------------------------------------------------------------------

# What to call it in the output: relative to $HOME where it is under it, so
# .zshrc stays .zshrc and ghostty reads .config/ghostty.
dotfile_label() {
  printf '%s\n' "${1#"$HOME"/}"
}

# Is this link in place already? Compared through the symlink's own directory,
# so a relative link to the same file counts as linked.
dotfile_linked() {
  local source="$1" target="$2" link_dest
  [[ -L "$target" ]] || return 1
  link_dest="$(readlink "$target" || true)"
  [[ "$link_dest" == "$source" ]] && return 0
  [[ -e "$target" && -e "$source" ]] || return 1
  [[ "$(cd "$(dirname "$target")" && cd "$(dirname "$link_dest")" 2>/dev/null && pwd)/$(basename "$link_dest")" == "$source" ]]
}

dotfile_status() {
  local source="$1" target="$2"
  if [[ -L "$target" ]]; then
    if dotfile_linked "$source" "$target"; then echo "present"
    else echo "relink (points to $(readlink "$target" || true))"; fi
  elif [[ -e "$target" ]]; then
    echo "exists (not symlinked)"
  else
    echo "MISSING"
  fi
}

link_dotfile() {
  local source="$1" target="$2" label="$3" link_dest bak

  if [[ -L "$target" ]]; then
    if dotfile_linked "$source" "$target"; then
      echo "  ok      $label (already linked)"
      skipped+=("dotfile:$label")
      return 0
    fi
    link_dest="$(readlink "$target" || true)"
    if ln -sfn "$source" "$target"; then
      echo "  relink  $label -> $source (was $link_dest)"
      installed+=("dotfile:$label")
    else
      echo "  FAILED  to relink $label" >&2
      failed+=("dotfile:$label")
    fi
  elif [[ -e "$target" ]]; then
    bak="${target}.bak"
    if [[ -e "$bak" || -L "$bak" ]]; then
      bak="${target}.bak.$(date +%Y%m%d%H%M%S)"
    fi
    if mv "$target" "$bak" && ln -s "$source" "$target"; then
      echo "  link    $label -> $source (backed up existing to $(basename "$bak"))"
      installed+=("dotfile:$label")
    else
      echo "  FAILED  to link $label (backup failed)" >&2
      failed+=("dotfile:$label")
    fi
  else
    if ln -s "$source" "$target"; then
      echo "  link    $label -> $source"
      installed+=("dotfile:$label")
    else
      echo "  FAILED  to link $label" >&2
      failed+=("dotfile:$label")
    fi
  fi
}

symlink_features() {
  local feature src target platform source
  while read -r feature; do
    echo
    echo "--- $feature ---"
    while IFS=$'\t' read -r src target platform; do
      if [[ "$platform" == "BAD" ]]; then
        echo "  FAILED  $feature/manifest: target '$target' for $src is not an absolute path" >&2
        failed+=("manifest:$feature")
        continue
      fi
      if ! wanted_here "$platform"; then
        echo "  skipped $(dotfile_label "$target") (for $platform, this is $PLATFORM)"
        skipped+=("dotfile:$src")
        continue
      fi
      source="$DOTFILES_DIR/$feature/$src"
      if [[ ! -e "$source" ]]; then
        echo "  FAILED  $feature/manifest declares $src, which is not here" >&2
        failed+=("dotfile:$src")
        continue
      fi
      # $XDG_CONFIG_HOME and any other parent need not exist yet.
      mkdir -p "$(dirname "$target")"
      link_dotfile "$source" "$target" "$(dotfile_label "$target")"
    done < <(manifest_entries "$feature")
  done < <(selected_features)

  if [[ "$PLATFORM" == "termux" ]] && have termux-reload-settings; then
    echo
    echo "  reload  termux settings"
    termux-reload-settings || true
  fi
}

# ---------------------------------------------------------------------------
# zsh: the shell these files are written for
# ---------------------------------------------------------------------------

ensure_prezto() {
  # shell/zshrc sources ${ZDOTDIR:-$HOME}/.zprezto/init.zsh; without it the
  # prompt, completions and modules that zshrc assumes are simply not there.
  if [[ -e "$ZPREZTO_DIR" ]]; then
    echo "  ok      zprezto (found $ZPREZTO_DIR)"
    if [[ -d "$ZPREZTO_DIR/.git" ]]; then
      echo "  sync    zprezto submodules"
      git -C "$ZPREZTO_DIR" submodule sync --recursive 2>/dev/null || true
      if ! git -C "$ZPREZTO_DIR" submodule update --init --recursive; then
        echo "  WARNING zprezto submodule sync had errors. If modules fail to load," >&2
        echo "          remove and re-clone with: rm -rf $ZPREZTO_DIR && $0" >&2
      fi
    else
      echo "  WARNING $ZPREZTO_DIR is not a git repository." >&2
      echo "          Re-clone with: rm -rf $ZPREZTO_DIR && $0" >&2
    fi
    skipped+=("zprezto")
    return 0
  fi
  echo "  clone   zprezto -> $ZPREZTO_DIR"
  if git clone --recursive "$PREZTO_REPO" "$ZPREZTO_DIR"; then
    installed+=("zprezto")
  else
    echo "  FAILED to clone zprezto" >&2
    failed+=("zprezto")
  fi
}

compile_zsh_scripts() {
  if ! have zsh; then
    return 0
  fi
  echo "  compile zsh dotfiles and prezto (.zwc)"
  local dot to_compile=()
  for dot in "$HOME/.zshenv" "$HOME/.zprofile" "$HOME/.zshrc" "$HOME/.zpreztorc" "$HOME/.zlogin"; do
    if [[ -f "$dot" && (! -f "${dot}.zwc" || "$dot" -nt "${dot}.zwc") ]]; then
      to_compile+=("$dot")
    fi
  done
  if [[ -d "$ZPREZTO_DIR" ]]; then
    while read -r src; do
      if [[ -f "$src" && (! -f "${src}.zwc" || "$src" -nt "${src}.zwc") ]]; then
        to_compile+=("$src")
      fi
    done < <(find "$ZPREZTO_DIR" -type f \( -name "*.zsh" -o -name "*.zsh-theme" \) 2>/dev/null)
  fi
  if [[ ${#to_compile[@]} -gt 0 ]]; then
    zsh -c 'for f in "$@"; do zcompile "$f" 2>/dev/null || true; done' _ "${to_compile[@]}"
    installed+=("zsh-byte-compilation")
  else
    skipped+=("zsh-byte-compilation")
  fi
}

ensure_login_shell() {
  local zsh_path current
  if ! have zsh; then
    echo "  SKIPPED -- zsh is not installed; install it before changing the login shell" >&2
    failed+=("login-shell")
    return 0
  fi
  zsh_path="$(command -v zsh)"
  current="${SHELL:-}"
  if [[ "$current" == "$zsh_path" ]]; then
    echo "  ok      login shell is already $zsh_path"
    skipped+=("login-shell")
    return 0
  fi
  # chsh refuses a shell that is not listed in /etc/shells, and the error is
  # obscure enough to be worth pre-empting (Termux does not use /etc/shells).
  if [[ "$PLATFORM" != "termux" && -r /etc/shells ]] && ! grep -qxF "$zsh_path" /etc/shells; then
    echo "  SKIPPED -- $zsh_path is not in /etc/shells, so chsh would refuse it." >&2
    echo "             Add it (needs sudo), then re-run:" >&2
    echo "               echo $zsh_path | sudo tee -a /etc/shells" >&2
    failed+=("login-shell")
    return 0
  fi
  # Prompts for a password on desktop/server, but not in Termux.
  if [[ "$PLATFORM" == "termux" ]]; then
    echo "  chsh    $current -> $zsh_path"
  else
    echo "  chsh    $current -> $zsh_path (will ask for your password)"
  fi
  if chsh -s "$zsh_path"; then
    echo "  ok      login shell set; it takes effect on the next login"
    installed+=("login-shell")
  else
    echo "  FAILED  chsh did not change the login shell" >&2
    failed+=("login-shell")
  fi
}

# ---------------------------------------------------------------------------
# tmux plugins
# ---------------------------------------------------------------------------

# A plugin's clone directory is named after the *repository* alone -- tpm takes
# `basename' of the plugin spec and drops any `#ref' (scripts/install_plugins.sh,
# `IFS='#' read'). So two owners publishing a repository of the same name collide
# on one directory, and tpm's "already installed" test is that directory
# existing -- it never looks at where the clone came from.
#
# Which is a silent wrong answer rather than a failure. Switching the theme from
# dracula/tmux to catppuccin/tmux left the old dracula clone in
# ~/.tmux/plugins/tmux, tpm reported "Already installed", and tmux.conf's
# @catppuccin_* options went to a plugin that never reads them. Every other
# plugin in the same run installed fine, so nothing looked broken.
#
# Compared by owner/repo rather than by URL: the same repository is reached over
# https, over ssh and with credentials embedded, and no spelling of it is wrong.
_repo_slug() {
  local url="${1%.git}"
  url="${url%/}"
  # Collapse ':' into '/' so scheme, credentials and host fall away with the rest
  # of the leading path once only the last two segments are kept.
  url="${url//:/\/}"
  local repo="${url##*/}"
  local rest="${url%/*}"
  local owner="${rest##*/}"
  printf '%s/%s' "$owner" "$repo" | tr '[:upper:]' '[:lower:]'
}

ensure_tpm_plugin_origins() {
  local conf="$DOTFILES_DIR/tmux/tmux.conf"
  local plugins_dir
  plugins_dir="$(dirname "$TPM_DIR")"
  [[ -f "$conf" ]] || return 0
  [[ -d "$plugins_dir" ]] || return 0

  # tpm decides from the *live* tmux.conf, so acting on this repository's copy is
  # only sound while the two are the same file. On a run that did not link tmux
  # -- `--only shell' -- they need not be, and a hand-written ~/.tmux.conf
  # declaring other plugins must not have its clones moved aside on the strength
  # of a file tmux never reads.
  local src target rest linked=0
  if [[ -f "$DOTFILES_DIR/tmux/manifest" ]]; then
    while IFS=$'\t' read -r src target rest; do
      [[ "$src" == "tmux.conf" ]] || continue
      dotfile_linked "$conf" "$target" && linked=1
    done < <(manifest_entries tmux)
  fi
  [[ $linked -eq 1 ]] || return 0

  local spec name dir want got aside n
  while read -r spec; do
    [[ -n "$spec" ]] || continue
    spec="${spec%%#*}"                 # drop the '#ref' tpm strips too
    # No owner, no comparison: a bare "tpm" would normalise to tpm/tpm and so
    # mismatch every real clone, moving a correct plugin aside over a typo tpm
    # cannot clone from either.
    [[ "$spec" == */* ]] || continue
    want="$(_repo_slug "$spec")"
    name="$(basename "$spec")"; name="${name%.git}"
    dir="$plugins_dir/$name"
    [[ -d "$dir" ]] || continue        # not installed yet; tpm will clone it

    # tpm itself is ensure_tpm's to manage, and moving it aside here would take
    # bin/install_plugins with it -- leaving the run installing nothing at all,
    # silently, since the step below only tests whether that file is executable.
    # A tpm cloned from a fork or a mirror is a legitimate reason for the slugs
    # to differ, so this cannot be left to the comparison.
    [[ "$dir" != "$TPM_DIR" ]] || continue

    if [[ ! -d "$dir/.git" ]]; then
      echo "  WARNING $name is not a git clone, so its origin cannot be checked;" >&2
      echo "          tpm will treat it as installed. Remove $dir to re-clone." >&2
      continue
    fi

    got="$(_repo_slug "$(git -C "$dir" remote get-url origin 2>/dev/null || true)")"
    [[ -n "$got" && "$got" != "/" && "$got" != "$want" ]] || continue

    # Moved, not deleted: the directory is a clone and cheap to restore, but it
    # is not this script's to throw away.
    aside="$dir.replaced-${got%%/*}"
    n=1
    while [[ -e "$aside" ]]; do aside="$dir.replaced-${got%%/*}.$n"; n=$((n + 1)); done
    echo "  fix     $name holds $got but tmux.conf declares $want"
    if mv "$dir" "$aside"; then
      echo "          moved to $aside; tpm will clone the declared plugin"
      installed+=("tpm-plugin-dir-$name")
    else
      echo "  FAILED  could not move $dir aside" >&2
      failed+=("tpm-plugin-dir-$name")
    fi
  done < <(awk '/^[ \t]*set(-option)? +-g +@plugin/ { gsub(/'\''/,""); gsub(/"/,""); print $4 }' "$conf")
}

ensure_tpm() {
  if [[ -e "$TPM_DIR" ]]; then
    echo "  ok      tpm (found $TPM_DIR)"
    skipped+=("tpm")
  else
    echo "  clone   tpm -> $TPM_DIR"
    if git clone "$TPM_REPO" "$TPM_DIR"; then
      installed+=("tpm")
    else
      echo "  FAILED to clone tpm" >&2
      failed+=("tpm")
      return 0
    fi
  fi
  # Before tpm decides what is "already installed", since that test is the
  # clone directory existing and cannot see a stale plugin occupying it.
  ensure_tpm_plugin_origins

  if [[ -x "$TPM_DIR/bin/install_plugins" ]]; then
    echo "  install tpm plugins"
    if TMUX_PLUGIN_MANAGER_PATH="$(dirname "$TPM_DIR")" "$TPM_DIR/bin/install_plugins"; then
      installed+=("tpm-plugins")
    else
      echo "  FAILED to install tpm plugins" >&2
      failed+=("tpm-plugins")
    fi
    local thumbs_dir="$(dirname "$TPM_DIR")/tmux-thumbs"
    if [[ -d "$thumbs_dir" && ! -f "$thumbs_dir/target/release/thumbs" ]]; then
      if have cargo; then
        echo "  build   tmux-thumbs binary (cargo)"
        if cargo build --release --manifest-path "$thumbs_dir/Cargo.toml" --target-dir "$thumbs_dir/target" >/dev/null 2>&1; then
          installed+=("tmux-thumbs-binary")
        fi
      fi
    fi
  fi
}

# ---------------------------------------------------------------------------
# mosh
#
# Keeps an ssh editing session alive across roaming, sleep and IP changes, which
# is what editing from a tablet on a cellular link needs.
#
# mosh is also in dotemacs's install-prereqs inventory, being an ordinary brew
# formula. That is not a conflict: both check for it first and skip when it is
# there, so whichever runs first installs it. It is installed here too because
# this repository is deployed on machines that have no dotemacs checkout at all.
#
# The check below is the part that belongs *only* here, since what it verifies is
# whether this repository's own zshenv got linked.
# ---------------------------------------------------------------------------

install_mosh() {
  if have mosh-server; then
    echo "  ok      mosh (found $(command -v mosh-server))"
    skipped+=("mosh")
  elif have brew; then
    echo "  install mosh (brew)"
    if brew install mosh; then
      installed+=("mosh")
    else
      echo "  FAILED to install mosh" >&2
      failed+=("mosh")
      return 0
    fi
  elif have pkg; then
    echo "  install mosh (pkg)"
    if pkg install -y mosh; then
      installed+=("mosh")
    else
      echo "  FAILED to install mosh" >&2
      failed+=("mosh")
      return 0
    fi
  else
    # Package names diverge enough between distros that guessing is worse than
    # saying so.
    echo "  SKIPPED -- mosh not installed and no brew here." >&2
    echo "             Install it with this machine's package manager" >&2
    echo "             (apt install mosh / pacman -S mosh / pkg install mosh)." >&2
    failed+=("mosh")
    return 0
  fi

  # The check that matters. mosh starts its server through a *non-interactive*
  # ssh command -- roughly `ssh host mosh-server new' -- and zsh reads only
  # ~/.zshenv for one of those, never .zprofile. On Apple Silicon the PATH such
  # a shell gets is /bin:/usr/bin:/usr/ucb:/usr/local/bin, with no
  # /opt/homebrew/bin in it, so `mosh host' reports "mosh-server not found" on a
  # machine where mosh is plainly installed. shell/zshenv exists to fix that,
  # which makes this a check on whether it is linked.
  if ! have zsh; then
    echo "  note    zsh absent, so ~/.zshenv is not the relevant path here"
  elif env -i HOME="$HOME" zsh -c 'command -v mosh-server' >/dev/null 2>&1; then
    echo "  ok      a non-interactive shell can find mosh-server"
  else
    echo "  WARNING mosh-server is installed, but a non-interactive shell cannot" >&2
    echo "          find it, so connecting fails with 'mosh-server not found'." >&2
    echo "          ~/.zshenv should be linked -- re-run this script." >&2
  fi
  # Reported rather than done: opening a port needs sudo and a decision about
  # this host's exposure, neither of which belongs in an unattended script.
  echo "  note    inbound UDP 60000-61000 must reach mosh-server."
  echo "          macOS: System Settings > Network > Firewall > Options,"
  echo "          then allow incoming connections for mosh-server."
}

# ---------------------------------------------------------------------------
# --list
# ---------------------------------------------------------------------------

print_inventory() {
  local feature src target platform status
  echo "== login shell =="
  if have zsh; then
    status="$([[ "${SHELL:-}" == "$(command -v zsh)" ]] && echo present || echo "MISSING (is ${SHELL:-unset})")"
  else
    status="MISSING (zsh not installed)"
  fi
  printf '  %-24s %s\n' "zsh" "$status"

  echo
  echo "== supporting checkouts =="
  printf '  %-24s -> %-24s %s\n' ".zprezto" "sorin-ionescu/prezto" \
    "$([[ -e "$ZPREZTO_DIR" ]] && echo present || echo MISSING)"
  printf '  %-24s -> %-24s %s\n' ".tmux/plugins/tpm" "tmux-plugins/tpm" \
    "$([[ -e "$TPM_DIR" ]] && echo present || echo MISSING)"
  printf '  %-24s %s\n' "mosh" \
    "$(have mosh-server && echo present || echo MISSING)"

  while read -r feature; do
    echo
    echo "== $feature =="
    while IFS=$'\t' read -r src target platform; do
      if [[ "$platform" == "BAD" ]]; then
        printf '  %-24s -> %-16s %s\n' "$target" "$src" "BAD (not an absolute path)"
        continue
      fi
      if wanted_here "$platform"; then
        printf '  %-24s -> %-16s %s\n' \
          "$(dotfile_label "$target")" "$src" \
          "$(dotfile_status "$DOTFILES_DIR/$feature/$src" "$target")"
      else
        printf '  %-24s -> %-16s %s\n' \
          "$(dotfile_label "$target")" "$src" "skipped ($platform only)"
      fi
    done < <(manifest_entries "$feature")
  done < <(selected_features)
}

# ---------------------------------------------------------------------------
# termux packages
# ---------------------------------------------------------------------------

ensure_termux_packages() {
  local script="$DOTFILES_DIR/termux/install-essentials"
  if [[ ! -x "$script" ]]; then
    return 0
  fi
  if have pkg; then
    echo "  install termux essentials"
    if "$script"; then
      installed+=("termux-essentials")
    else
      echo "  FAILED to install termux essentials" >&2
      failed+=("termux-essentials")
    fi
  else
    echo "  SKIPPED -- 'pkg' not found, skip termux package install"
    skipped+=("termux-essentials")
  fi
}

ensure_hostname() {
  local target="$HOME/.hostname" chosen_host="" default_host=""
  if [[ -n "${CUSTOM_HOSTNAME:-}" ]]; then
    chosen_host="$CUSTOM_HOSTNAME"
  elif [[ "$PLATFORM" == "termux" && ! -e "$target" ]]; then
    default_host="$(getprop ro.product.model 2>/dev/null || getprop ro.product.device 2>/dev/null || echo "tablet")"
    default_host="$(echo "$default_host" | tr '[:upper:] ' '[:lower:]-' | tr -cd '[:alnum:]-_')"
    default_host="${default_host:-tablet}"
    if [[ -t 0 ]]; then
      read -r -p "  hostname for prompt [$default_host]: " chosen_host || true
      chosen_host="${chosen_host:-$default_host}"
    else
      chosen_host="$default_host"
    fi
  fi

  if [[ -n "$chosen_host" ]]; then
    echo "$chosen_host" > "$target"
    echo "  hostname $chosen_host (saved in ~/.hostname)"
    installed+=("hostname:$chosen_host")
  elif [[ -e "$target" ]]; then
    echo "  ok      hostname ($(cat "$target"))"
    skipped+=("hostname")
  fi
}

# ---------------------------------------------------------------------------
# Run
# ---------------------------------------------------------------------------

# A typo in a feature name should stop the run, not silently do nothing at all
# (--only) or everything (--skip).
# The ${a[@]+...} form is deliberate: under `set -u' bash 3.2, which is what
# macOS ships, expanding an empty array is an unbound-variable error.
for name in ${ONLY[@]+"${ONLY[@]}"} ${SKIP[@]+"${SKIP[@]}"}; do
  if ! feature_exists "$name"; then
    echo "no such feature: $name" >&2
    echo "available: $(feature_list | tr '\n' ' ')" >&2
    exit 2
  fi
done

echo "==> dotfiles setup ($DOTFILES_DIR, $PLATFORM)"

if [[ $DO_LIST -eq 1 ]]; then
  echo
  print_inventory
  exit 0
fi

symlink_features

ensure_hostname

if [[ $DO_LINK_ONLY -eq 0 ]]; then
  if [[ "$PLATFORM" == "termux" && $DO_PACKAGES -eq 1 ]]; then
    echo
    echo "--- termux packages ---"
    ensure_termux_packages
  fi

  echo
  echo "--- zsh ---"
  ensure_prezto
  compile_zsh_scripts
  if [[ $DO_CHSH -eq 1 ]]; then
    ensure_login_shell
  fi

  echo
  echo "--- tmux plugins ---"
  ensure_tpm

  if [[ $DO_MOSH -eq 1 ]]; then
    echo
    echo "--- mosh (remote sessions) ---"
    install_mosh
  fi
fi

echo
echo "==> Summary"
echo "    installed:  ${#installed[@]}${installed[*]:+  ${installed[*]}}"
echo "    already ok: ${#skipped[@]}"
if [[ ${#failed[@]} -gt 0 ]]; then
  echo "    FAILED:     ${#failed[@]}  ${failed[*]}" >&2
  exit 1
fi
echo
echo "Environment ready."
